{{~ for mod in __mod.sub_mods ~}}
pub mod {{mod.name}};
{{~end~}}

{{~ if __mod.name != '' ~}}
use super::*;
{{~end~}}
use atom_datatables::{ByteBuf, LubanError, Table};

{{~ for enum in __mod.enums ~}}
{{~ if enum.comment != '' ~}}
///{{enum.comment | html.escape}}
{{~end~}}
{{~ if enum.is_flags ~}}
bitflags::bitflags!{    
    #[derive(Debug, Hash, Eq, PartialEq)]
    pub struct {{enum.name}} : u32 {
        {{~ for item in enum.items ~}}
    {{~if item.comment_or_alias != '' ~}}
        ///{{item.comment_or_alias | html.escape}}
    {{~end~}}
        const {{item.name}} = {{item.int_value}};
        {{~end~}}
    }
}
{{~else~}}
#[derive(Debug, Hash, Eq, PartialEq, atom_datatables::serde::Deserialize)]
#[serde(crate = "atom_datatables::serde", from = "i32")]
pub enum {{enum.name}} {
    {{~ for item in enum.items ~}}
{{~if item.comment_or_alias != '' ~}}
    ///{{item.comment_or_alias | html.escape}}
{{~end~}}
    {{item.name}} = {{item.value}},
    {{~end~}}
    {{~if enum.items.empty?~}}
    None
    {{~end~}}
}

impl From<i32> for {{enum.name}} {
    fn from(value: i32) -> Self {
        match value { 
            {{~ for item in enum.items ~}}
            {{item.value}} => {{enum.name}}::{{item.name}},
            {{~end~}}
            _ => panic!("Invalid value for {{enum.name}}:{}", value),
        }
    }
}

{{~end~}}
{{~end~}}
{{~ for bean in __mod.beans 
    hierarchy_fields = bean.hierarchy_export_fields
~}}
{{~ if bean.is_abstract_type || bean.parent != '' ~}}
compile_error!("rust-bevy 目标暂不支持多态 bean（抽象 / 继承）：{{bean.name}}");
{{~ else ~}}
#[derive(Debug, atom_datatables::serde::Deserialize)]
#[serde(crate = "atom_datatables::serde")]
pub struct {{bean.name}} {
    {{~ for field in hierarchy_fields ~}}
{{~if field.comment != '' ~}}
    /// {{escape_comment field.comment}}
{{~end~}}
{{~if need_marshal_bool_prefix field.ctype ~}}
    #[serde(default)]
{{~end~}}
    pub {{field.name}}: {{declaring_type_name field.ctype}},
    {{~end~}}
}

impl {{bean.name}}{
    pub fn new(buf: &mut ByteBuf) -> Result<{{bean.name}}, LubanError> {
        {{~ for field in hierarchy_fields ~}}
        {{deserialize field.name 'buf' field.ctype}}
        {{~end~}}
        
        Ok({{bean.name}} { {{ for field in hierarchy_fields }}{{field.name}}, {{end}}})
    }

    pub const __ID__: i32 = {{bean.id}};
}
{{~ end ~}}

{{~end~}}
{{~ for table in __mod.tables
    key_type = declaring_type_name table.key_ttype
    value_type = declaring_type_name table.value_ttype
    value_arc = "std::sync::Arc<" + value_type + ">"
    name = table.name
    map_type = "std::collections::HashMap<" + key_type + ", " + value_arc + ">"
~}}
{{
    
    func index_type_name
        ret (declaring_type_name $0.type)
    end
    
    func table_union_map_type_name
        ret 'std::collections::HashMap<(' + (array.each table.index_list @index_type_name | array.join ', ') + '), ' + value_arc  + '>'
    end
    
    func table_key_list
        varName = $0
        indexList = table.index_list |array.each do; ret varName + '.' + (format_property_name __code_style $0.index_field.name); end;
        ret array.join indexList ', '
    end
    
    func table_param_def_list
        paramList = table.index_list |array.each do; ret (declaring_type_name $0.type) + ' ' + $0.index_field.name; end;
        ret array.join paramList ', '
    end
    
    func table_param_name_list
        paramList = table.index_list |array.each do; ret $0.index_field.name; end;
        ret array.join paramList ', '
    end
}}
{{~ if table.comment != '' ~}}
///{{table.comment | html.escape}}
{{~end~}}
#[derive(Debug)]
pub struct {{table.name}} {
    {{~if table.is_map_table ~}}
    pub data_list: Vec<{{value_arc}}>,
    pub data_map: {{map_type}},
    {{~else if table.is_list_table ~}}
    pub data_list: Vec<{{value_arc}}>,
    {{~if table.is_union_index~}}    
    pub data_map_union: {{table_union_map_type_name}},
    {{~else if !table.index_list.empty?~}}
    {{~for idx in table.index_list~}}
    pub data_map_{{idx.index_field.name}}: std::collections::HashMap<{{declaring_type_name idx.type}}, {{value_arc}}>,
    {{~end~}}
    {{~end~}}    
    {{~else~}}
    pub data: {{value_type}},
    {{~end~}}
}
{{~if table.is_map_table ~}}

impl {{name}} {
    /// 由已解析的记录构建表：`bin` 与 `json` 两条解析路径共用这里的索引构建逻辑。
    pub fn from_rows(rows: Vec<{{value_type}}>) -> Result<std::sync::Arc<{{name}}>, LubanError> {
        let mut data_map: {{map_type}} = Default::default();
        let mut data_list: Vec<{{value_arc}}> = Vec::with_capacity(rows.len());
        for row in rows {
            let row = std::sync::Arc::new(row);
            data_list.push(row.clone());
            data_map.insert(row.{{table.index_field.name}}.clone(), row.clone());
        }
        Ok(std::sync::Arc::new({{name}} { data_map, data_list }))
    }

    pub fn new(buf: &mut ByteBuf) -> Result<std::sync::Arc<{{name}}>, LubanError> {
        let mut rows: Vec<{{value_type}}> = Vec::new();
        for _ in 0..buf.read_size() {
            rows.push({{value_type}}::new(buf)?);
        }
        Self::from_rows(rows)
    }

    pub fn get<Q>(&self, key: &Q) -> Option<{{value_arc}}>
    where
        {{key_type}}: std::borrow::Borrow<Q>,
        Q: std::hash::Hash + Eq + ?Sized,
    {
        self.data_map.get(key).map(|x| x.clone())
    }
}

impl<Q> std::ops::Index<&Q> for {{name}}
where
    {{key_type}}: std::borrow::Borrow<Q>,
    Q: std::hash::Hash + Eq + ?Sized,
{
    type Output = {{value_arc}};

    fn index(&self, index: &Q) -> &Self::Output {
        self.data_map.get(index).unwrap()
    }
}
{{~else if table.is_list_table ~}}

impl {{name}} {
    pub fn from_rows(rows: Vec<{{value_type}}>) -> Result<std::sync::Arc<{{name}}>, LubanError> {
        let mut data_list: Vec<{{value_arc}}> = Vec::with_capacity(rows.len());
        for row in rows {
            data_list.push(std::sync::Arc::new(row));
        }
    {{~if table.is_union_index~}}
        let mut data_map_union: {{table_union_map_type_name}} = Default::default();
        for x in &data_list {
            data_map_union.insert(({{table_key_list "x"}}.clone()), x.clone());
        }
    {{~else if !table.index_list.empty?~}}
        {{~for idx in table.index_list~}}
        let mut data_map_{{idx.index_field.name}}: std::collections::HashMap<{{declaring_type_name idx.index_field.ctype}}, {{value_arc}}> = Default::default();
        {{~end~}}
        for x in &data_list {
        {{~for idx in table.index_list~}}
            data_map_{{idx.index_field.name}}.insert(x.{{format_property_name __code_style idx.index_field.name}}.clone(), x.clone());
        {{~end~}}
        }
    {{~end~}}

        Ok(std::sync::Arc::new({{table.name}} { 
                data_list,
    {{~if table.is_union_index~}}
                data_map_union,
    {{~else if !table.index_list.empty?~}}
        {{~for idx in table.index_list~}}
                data_map_{{idx.index_field.name}},
        {{~end~}}
    {{~end~}}
            }))
    }

    pub fn new(buf: &mut ByteBuf) -> Result<std::sync::Arc<{{name}}>, LubanError> {
        let mut rows: Vec<{{value_type}}> = Vec::new();
        for _ in 0..buf.read_size() {
            rows.push({{value_type}}::new(buf)?);
        }
        Self::from_rows(rows)
    }

    {{~if table.is_union_index~}}
    pub fn get<Q>(&self, key: &Q) -> Option<{{value_arc}}>
    where
        ({{array.each table.index_list @index_type_name | array.join ', '}}): std::borrow::Borrow<Q>,
        Q: std::hash::Hash + Eq + ?Sized,
    {
        self.data_map_union.get(key).map(|x| x.clone())
    }
    {{~else if !table.index_list.empty? ~}}
    {{~for idx in table.index_list
        index = format_property_name __code_style idx.index_field.name
    ~}}
    pub fn get_by_{{index}}<Q>(&self, key: &Q) -> Option<{{value_arc}}>
    where
        {{declaring_type_name idx.type}}: std::borrow::Borrow<Q>,
        Q: std::hash::Hash + Eq + ?Sized,
    {
        self.data_map_{{index}}.get(key).map(|x| x.clone())
    }
    {{~end~}}
    {{~end~}}
}
{{~else~}}

impl {{name}} {
    pub fn from_rows(rows: Vec<{{value_type}}>) -> Result<std::sync::Arc<{{name}}>, LubanError> {
        if rows.len() != 1 {
            return Err(LubanError::Table(format!("table mode=one, but size != 1")));
        }
        let data = rows.into_iter().next().unwrap();
        Ok(std::sync::Arc::new({{name}} { data }))
    }

    pub fn new(buf: &mut ByteBuf) -> Result<std::sync::Arc<{{name}}>, LubanError> {
        let n = buf.read_size();
        if n != 1 { return Err(LubanError::Table(format!("table mode=one, but size != 1"))); }
        let data = {{value_type}}::new(buf)?;
        Ok(std::sync::Arc::new({{name}} { data }))
    }
}
{{~end~}}

{{~end~}}
